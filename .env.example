PORT=5000
MONGODB_URI=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYSTACK_SECRET_KEY=

# Transactional email. Resend is recommended for Render deployments.
RESEND_API_KEY=
RESEND_FROM=BuiltRight Services <notifications@builtrightltd.com>

# Optional SMTP fallback when RESEND_API_KEY is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

BANK_PROVIDER_ENABLED=false
BANK_PROVIDER_NAME=
BANK_PROVIDER_BASE_URL=
BANK_PROVIDER_CLIENT_ID=
BANK_PROVIDER_CLIENT_SECRET=
BANK_PROVIDER_WEBHOOK_SECRET=
BANK_APPLICATION_URL=
BANK_APPLICATION_EMAIL=
FRONTEND_URL=https://www.builtrightltd.com

INSPECTION_PAYMENT_BANK=FCMB
INSPECTION_PAYMENT_ACCOUNT=2008839924
INSPECTION_PAYMENT_ACCOUNT_NAME=BuiltRight Services Ltd

# Transactional SMS via Termii. Use the account-specific base URL shown
# in the Termii dashboard and activate the DND channel for critical messages.
TERMII_BASE_URL=
TERMII_API_KEY=
TERMII_SENDER_ID=BuiltRight
TERMII_CHANNEL=dnd

# AshGridX staging and production connection points. Do not enable outbound
# commands until sandbox tests and the remaining provider user guides pass.
ASHGRIDX_ENABLED=false
ASHGRIDX_COMMANDS_ENABLED=false
ASHGRIDX_ENVIRONMENT=staging
ASHGRIDX_STAGING_API_BASE_URL=https://staging.ashgridx.ashgridxapis.com
ASHGRIDX_PRODUCTION_API_BASE_URL=https://ashgridx.ashgridxapis.com
ASHGRIDX_API_KEY=
ASHGRIDX_WEBHOOK_SECRET=
ASHGRIDX_WEBHOOK_SIGNATURE_HEADER=x-ashgridx-signature
ASHGRIDX_WEBHOOK_TIMESTAMP_HEADER=x-ashgridx-timestamp
ASHGRIDX_WEBHOOK_TOLERANCE_SECONDS=120
ASHGRIDX_DISCONNECT_PATH=
ASHGRIDX_ACTIVATION_TOKEN_PATH=
